# Copy to .env.local and fill in. Never commit .env.local.

# Which AI provider runs the table: openai (default) or anthropic
AI_PROVIDER=openai

# OpenAI (default provider)
OPENAI_API_KEY=
# Optional model overrides (structured calls / in-character speeches)
OPENAI_MODEL_FAST=gpt-5.4-mini
OPENAI_MODEL_SPEECH=gpt-5.5

# Anthropic (AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=
# Optional model overrides; set ANTHROPIC_MODEL_SPEECH=claude-opus-5-5 for the best voices
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_SPEECH=claude-sonnet-5-5

# Voice output: browser (free, default) or elevenlabs
TTS_PROVIDER=browser
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL=eleven_flash_v2_5
